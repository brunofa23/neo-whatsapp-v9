<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <title>Registro de Manifesto</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f6f9fc;
      margin: 0;
      padding: 0;
    }
    .email-container {
      max-width: 700px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    .header {
      background-color: #004085;
      color: #ffffff;
      padding: 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
    }
    .content {
      padding: 20px;
    }
    .content h2, .content h3 {
      color: #333333;
      margin: 10px 0 5px;
    }
    .content p {
      margin: 5px 0;
      color: #555555;
    }
    .footer {
      background-color: #e9ecef;
      text-align: center;
      padding: 10px;
      font-size: 12px;
      color: #666666;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="header">
      <h1>Registro de Manifesto</h1>
    </div>
    <div class="content">
      <h3>Registro: {{ reg }}</h3>
      <h3>Paciente: {{ name_pac }}</h3>
      <h3>Celular: {{ cellphone }}</h3>
      <p><strong>Médico:</strong> {{ medic_einvolved }}</p>
      <p><strong>Recepcionista:</strong> {{ employee_einvolved }}</p>
      <p><strong>Título:</strong> {{ mainsubject }}</p>
      <p><strong>Gestor Responsável:</strong> {{ user_resposible }}</p>
      <p><strong>Assunto Principal:</strong> {{ mainsubject }}</p>
      <p><strong>Relato do Paciente:</strong></p>
       <p> {{{report}}}</p>
      <p><strong>Data Limite:</strong> {{ date_limit }}</p>
      <p><strong>Causa Raiz:</strong> {{ root_cause }}</p>
      <p><strong>Ação:</strong> {{ action }}</p>
      <p><strong>Obs:</strong> {{ Obs }}</p>
    </div>
    <div class="footer">
      Este e-mail foi gerado automaticamente. Por favor, não responda.
    </div>
  </div>
</body>
</html>
